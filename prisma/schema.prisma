generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id             String   @id @default(cuid())
  description    String
  amount         Float
  category       String
  type           String   // "INCOME" or "EXPENSE"
  isSubscription Boolean  @default(false)
  createdAt      DateTime @default(now())
}
